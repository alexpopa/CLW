# Optional Node server settings. Export values before running npm run dev:server.
SERVER_PORT=8788
# Browser origins allowed to connect, comma-separated. Leave unset to allow any (private playtests).
# CLIENT_ORIGIN=http://localhost:5173
# Sign-in: "guest" (default; display name only, for LAN/tailnet play) or "dev" (mock login, localhost).

# Uncomment both settings to enable mock login on localhost only.
# NODE_ENV=development
# AUTH_PROVIDER=dev

# Hosted play uses AUTH_PROVIDER=rgboner and requires CLIENT_ORIGIN.
# SERVER_HOST=127.0.0.1
# MATCH_SERVER_URL=wss://your-match-host.example/
# MATCH_TICKET_SECRET= (64 lowercase hex characters, shared with the game Site)
